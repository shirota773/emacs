{
  "editor.colorDecorators": true,
  "editor.colorDecoratorsLimit": 500,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.semanticHighlighting.enabled": true,

  "workbench.colorCustomizations": {
    // Title Bar
    "titleBar.activeBackground": "#11111b",
    "titleBar.activeForeground": "#cba6f7",
    "titleBar.inactiveBackground": "#11111b",
    "titleBar.inactiveForeground": "#585b70",

    // Activity Bar
    "activityBar.background": "#11111b",
    "activityBar.foreground": "#cba6f7",
    "activityBar.inactiveForeground": "#585b70",
    "activityBar.border": "#1e1e2e",

    // Side Bar
    "sideBar.background": "#11111b",
    "sideBar.foreground": "#ffffff",
    "sideBar.border": "#1e1e2e",
    "sideBarSectionHeader.background": "#1e1e2e",
    "sideBarSectionHeader.foreground": "#ffffff",

    // Editor
    "editor.background": "#1e1e2e",
    "editor.foreground": "#cdd6f4",
    "editorLineNumber.foreground": "#585b70",
    "editorLineNumber.activeForeground": "#cba6f7",
    "editorCursor.foreground": "#cba6f7",
    "editor.selectionBackground": "#585b7066",
    "editor.lineHighlightBackground": "#313244",

    // Status Bar
    "statusBar.background": "#11111b",
    "statusBar.foreground": "#cdd6f4",
    "statusBar.border": "#1e1e2e",
    "statusBarItem.remoteBackground": "#cba6f7",
    "statusBarItem.remoteForeground": "#11111b",

    // Tab Bar
    "editorGroupHeader.tabsBackground": "#11111b",
    "tab.activeBackground": "#1e1e2e",
    "tab.activeForeground": "#cba6f7",
    "tab.inactiveBackground": "#11111b",
    "tab.inactiveForeground": "#585b70",
    "tab.border": "#1e1e2e",

    // Breadcrumbs
    "breadcrumb.background": "#1e1e2e",
    "breadcrumb.foreground": "#cba6f7",
    "breadcrumb.focusForeground": "#cba6f7",

    // Terminal
    "terminal.background": "#1e1e2e",
    "terminal.foreground": "#cdd6f4",
    "terminalCursor.foreground": "#cba6f7",
    "terminalCursor.background": "#1e1e2e",
    "terminal.ansiBlack": "#45475a",
    "terminal.ansiBlue": "#89b4fa",
    "terminal.ansiCyan": "#94e2d5",
    "terminal.ansiGreen": "#a6e3a1",
    "terminal.ansiMagenta": "#cba6f7",
    "terminal.ansiRed": "#f38ba8",
    "terminal.ansiWhite": "#bac2de",
    "terminal.ansiYellow": "#f9e2af",
    "terminal.ansiBrightBlack": "#585b70",
    "terminal.ansiBrightBlue": "#89b4fa",
    "terminal.ansiBrightCyan": "#94e2d5",
    "terminal.ansiBrightGreen": "#a6e3a1",
    "terminal.ansiBrightMagenta": "#cba6f7",
    "terminal.ansiBrightRed": "#f38ba8",
    "terminal.ansiBrightWhite": "#a6adc8",
    "terminal.ansiBrightYellow": "#f9e2af"
  }
}
# Ignore init-loader logs
inits/*@*
inits/*.local.*

# Emacs package manager and temporary files
elpa/
auto-save-list/

# Byte-compiled output
*.elc

# Manually installed tools (currently unused)
site-lisp/
auto-install/
dired-hacks/

# macOS system files
.DS_Store

# VSCode extension dumps (dap-mode/lsp download cache)
.extension/

# Claude Code configuration
CLAUDE.md
.claude

# Package-installed assets (再取得できるので追跡しない)
all-the-icons-fonts/
yasnippet-snippets/

# Customize の保存先 (init.el で custom-file は null-device にしてある)
custom-set-variables.el

# Temporary workspace backups
unused/
backups/

# no-littering directories
var/
etc/
